// Source: infra/README.md "How the stacks connect" (mermaid flowchart). Redrawn as a UML component diagram: the
// stacks are «Terraform stack» components, the arrows are dependencies (dashed, open arrowhead) labelled with what
// flows; «deploy» marks what Argo CD applies.
digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.8, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f6fb", color="#3b4252", fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge  [style=dashed, arrowhead=vee, arrowsize=0.7, color="#3b4252", fontname="Helvetica", fontsize=8];
  b  [label=<<font point-size="8">«Terraform stack»</font><br/><b>bootstrap</b><br/><font point-size="8">local state</font>>];
  st [label=<<font point-size="8">«artifact»</font><br/>S3 state bucket<br/>+ DynamoDB lock table>, style="filled", fillcolor="#ffffff"];
  i  [label=<<font point-size="8">«Terraform stack»</font><br/><b>infra</b><br/><font point-size="8">VPC, EKS, RDS, MSK, EMR, S3, SQS,<br/>Lambda, DynamoDB, ECR, IAM</font>>];
  p  [label=<<font point-size="8">«Terraform stack»</font><br/><b>platform</b><br/><font point-size="8">Helm releases, DB users, Secrets</font>>];
  a  [label=<<font point-size="8">«component»</font><br/><b>Argo CD</b><br/><font point-size="8">namespace argocd</font>>];
  g  [label=<<font point-size="8">«artifact»</font><br/>Git: gitops/apps/&lt;env&gt;.yaml<br/>→ k8s/overlays/&lt;env&gt;>, style="filled", fillcolor="#ffffff"];
  k  [label=<<font point-size="8">«namespace»</font><br/><b>claims</b>>];
  b -> st [label="creates"];
  i -> st [label="backend state"];
  p -> st [label="backend state"];
  p -> i  [label="terraform_remote_state: cluster, VPC,\nRDS endpoint + secret ARN, MSK brokers,\nbuckets, queues, table, IRSA ARNs"];
  p -> a  [label="Helm: argo-cd, AppProject claims,\nroot Application claims-root"];
  a -> g  [label="sync (prune, self-heal)"];
  a -> k  [label="«deploy» Deployments, Services,\nHPAs, Ingress, NetworkPolicies"];
  p -> k  [label="Secrets <svc>-db, jwt-keys,\nConfigMap platform-endpoints,\nIRSA service accounts"];
}
